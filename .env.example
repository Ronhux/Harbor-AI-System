 APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

VITE_APP_NAME="${APP_NAME}"

# Explicit owner-authorized activation is required before any Azure request.
AZURE_OPENAI_ENABLED=false

# Backup & Disaster Recovery: configure and validate before enabling.
BACKUP_ENABLED=false
BACKUP_STORAGE_PERMISSIONS_APPROVED=false
# BACKUP_ENCRYPTION_KEY= (separately escrowed base64 encoding of 32 random bytes)
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=14
# BACKUP_MYSQLDUMP_BINARY=absolute path to compatible mysqldump
# BACKUP_MYSQL_BINARY=absolute path to compatible mysql client
# BACKUP_SECONDARY_ROOT=existing private secondary location outside this project
# BACKUP_FCA_EVIDENCE_ROOT=actual approved private evidence directory
BACKUP_RECOVERY_DRILL_ENABLED=false
BACKUP_RECOVERY_PORT=3307
# BACKUP_RECOVERY_PASSWORD=restricted isolated recovery user password
